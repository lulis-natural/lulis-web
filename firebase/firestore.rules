rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function maxLen(field, n) {
      return field.size() <= n;
    }

    // ── /productos ──────────────────────────────────────────
    // Público: lectura (filtro de disponibles se hace en el cliente).
    // Admin: CRUD completo.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── /galeria ────────────────────────────────────────────
    // Público: lectura (filtro de activos se hace en el cliente).
    // Admin: CRUD completo.
    match /galeria/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── /mensajes ───────────────────────────────────────────
    // Público: SOLO crear (formulario de contacto). Admin: leer/actualizar/eliminar.
    match /mensajes/{mensajeId} {
      allow create: if request.resource.data.keys().hasAll([
                         'nombre', 'email', 'mensaje', 'creadoEn'
                       ])
                    && maxLen(request.resource.data.nombre,  100)
                    && maxLen(request.resource.data.email,   200)
                    && maxLen(request.resource.data.mensaje, 2000)
                    && request.resource.data.creadoEn == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ── /ventas ─────────────────────────────────────────────
    // Privado: solo admin.
    match /ventas/{ventaId} {
      allow read, write: if isAdmin();
    }

    // ── /configuracion ──────────────────────────────────────
    // Público: leer 'sitio'. Admin: CRUD completo.
    match /configuracion/{docId} {
      allow read: if docId == 'sitio' || isAdmin();
      allow write: if isAdmin();
    }

    // ── /impacto_ambiental ──────────────────────────────────
    // Público: leer 'acumulado' (counters del hero). Admin: escribir.
    match /impacto_ambiental/{docId} {
      allow read: if docId == 'acumulado' || isAdmin();
      allow write: if isAdmin();
    }

    // ── /direcciones ────────────────────────────────────────
    // Público: leer (carrusel de ubicaciones). Admin: CRUD completo.
    match /direcciones/{dirId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Bloqueo por defecto ────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
