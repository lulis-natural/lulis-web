rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    // Cualquier usuario autenticado en Firebase Auth se considera Admin
    function isAdmin() {
      return request.auth != null;
    }

    function maxLen(field, n) {
      return field.size() <= n;
    }

    // ── /productos ──────────────────────────────────────────
    // Público: lectura total para catálogo en vivo. Admin: CRUD completo.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── /galeria ────────────────────────────────────────────
    // Público: leer imágenes. Admin: CRUD completo.
    match /galeria/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── /mensajes ───────────────────────────────────────────
    // Público: crear mensaje de contacto. Admin: leer/actualizar/eliminar.
    match /mensajes/{mensajeId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── /ventas ─────────────────────────────────────────────
    // Solo admin.
    match /ventas/{ventaId} {
      allow read, write: if isAdmin();
    }

    // ── /configuracion ──────────────────────────────────────
    // Público: lectura de datos generales del sitio. Admin: CRUD completo.
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── /impacto_ambiental ──────────────────────────────────
    // Público: lectura de métricas para contadores. Admin: escribir.
    match /impacto_ambiental/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── /direcciones ────────────────────────────────────────
    // Público: leer ubicaciones y tiendas. Admin: CRUD completo.
    match /direcciones/{dirId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Bloqueo por defecto ────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
