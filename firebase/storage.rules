rules_version = '2';

// ═══════════════════════════════════════════════════════════
// LULIS — Reglas de seguridad Firebase Storage
//
// Público: leer cualquier imagen pública.
// Admin: cualquier usuario autenticado puede subir/actualizar/eliminar imágenes.
// Restricciones: solo imágenes, máximo 10 MB por archivo.
// ═══════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder10MB() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function validUpload() {
      return isAdmin() && isImage() && isUnder10MB();
    }

    // ── /productos/** ──────────────────────────────────────
    match /productos/{allPaths=**} {
      allow read:   if true;
      allow create, update: if validUpload();
      allow delete: if isAdmin();
    }

    // ── /galeria/** ────────────────────────────────────────
    match /galeria/{allPaths=**} {
      allow read:   if true;
      allow create, update: if validUpload();
      allow delete: if isAdmin();
    }

    // ── /general/** ────────────────────────────────────────
    match /general/{allPaths=**} {
      allow read:   if true;
      allow create, update: if validUpload();
      allow delete: if isAdmin();
    }

    // ── Resto de archivos ──────────────────────────────────
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
