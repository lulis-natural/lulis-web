{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/dashboard/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/productos",
      "destination": "/admin/productos.html"
    },
    {
      "source": "/admin/productos/",
      "destination": "/admin/productos.html"
    },
    {
      "source": "/admin/galeria",
      "destination": "/admin/galeria.html"
    },
    {
      "source": "/admin/galeria/",
      "destination": "/admin/galeria.html"
    },
    {
      "source": "/admin/direcciones",
      "destination": "/admin/direcciones.html"
    },
    {
      "source": "/admin/direcciones/",
      "destination": "/admin/direcciones.html"
    },
    {
      "source": "/admin/ventas",
      "destination": "/admin/ventas.html"
    },
    {
      "source": "/admin/ventas/",
      "destination": "/admin/ventas.html"
    },
    {
      "source": "/admin/reportes",
      "destination": "/admin/reportes.html"
    },
    {
      "source": "/admin/reportes/",
      "destination": "/admin/reportes.html"
    },
    {
      "source": "/admin/mensajes",
      "destination": "/admin/mensajes.html"
    },
    {
      "source": "/admin/mensajes/",
      "destination": "/admin/mensajes.html"
    },
    {
      "source": "/admin/impacto",
      "destination": "/admin/impacto.html"
    },
    {
      "source": "/admin/impacto/",
      "destination": "/admin/impacto.html"
    },
    {
      "source": "/admin/configuracion",
      "destination": "/admin/configuracion.html"
    },
    {
      "source": "/admin/configuracion/",
      "destination": "/admin/configuracion.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/catalogo",
      "destination": "/#products",
      "permanent": false
    },
    {
      "source": "/catalogo/",
      "destination": "/#products",
      "permanent": false
    },
    {
      "source": "/nosotros",
      "destination": "/#about",
      "permanent": false
    },
    {
      "source": "/nosotros/",
      "destination": "/#about",
      "permanent": false
    },
    {
      "source": "/galeria",
      "destination": "/#gallery",
      "permanent": false
    },
    {
      "source": "/galeria/",
      "destination": "/#gallery",
      "permanent": false
    },
    {
      "source": "/ubicaciones",
      "destination": "/#ubicaciones",
      "permanent": false
    },
    {
      "source": "/ubicaciones/",
      "destination": "/#ubicaciones",
      "permanent": false
    },
    {
      "source": "/contacto",
      "destination": "/#contact",
      "permanent": false
    },
    {
      "source": "/contacto/",
      "destination": "/#contact",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com https://fonts.googleapis.com https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.firebaseio.com https://firebasestorage.googleapis.com https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.gstatic.com https://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://firebasestorage.googleapis.com https://wa.me; frame-src 'self' https://www.instagram.com https://www.google.com https://maps.google.com https://*.firebaseapp.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/Imagenes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}