# ═══════════════════════════════════════════════════════════
# LULIS — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitear .env.local al repositorio.
# ═══════════════════════════════════════════════════════════

# Firebase — copiar desde Firebase Console > Configuración > Tu app web
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Admin inicial (para el script de setup)
ADMIN_EMAIL=admin@lulis.bo
